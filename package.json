{
  "name": "md-to-pdf-gui",
  "version": "1.0.0",
  "description": "Markdown to Single-Page PDF Converter with GUI",
  "author": "Wataru Sakamoto",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "set NODE_ENV=development&& electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:react && npm run build:electron"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "cors": "^2.8.5",
    "electron-store": "^11.0.2",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "marked": "^12.0.2",
    "puppeteer": "^22.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^42.3.3",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.example.md-to-pdf-gui",
    "productName": "Make-Ondai-Geppo",
    "copyright": "Copyright © 2026 Wataru Sakamoto. All rights reserved.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "Prompt.md",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Make-Ondai-Geppo",
      "license": "LICENSE.txt"
    }
  }
}
